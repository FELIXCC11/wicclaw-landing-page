# Replace the domain. Keep the Next.js upstream bound to localhost.
# Run Certbot for this server block before redirecting all HTTP traffic to HTTPS.
server {
  listen 80;
  server_name YOUR_DOMAIN;
  client_max_body_size 1m;
  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 60s;
  }
  location ^~ /admin/ {
    auth_basic "WICCLAW operations";
    auth_basic_user_file /etc/nginx/wicclaw-admin.htpasswd;
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header X-Robots-Tag "noindex, nofollow" always;
  }
}
