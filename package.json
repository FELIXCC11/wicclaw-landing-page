{
  "name": "wicclaw",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/assert-reference-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint app components data lib tests",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:payments && npm run build",
    "test": "tsx --test tests/*.test.ts",
    "test:payments": "node --conditions=react-server --import tsx --test tests/payments/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "emails:retry": "node scripts/retry-emails.mjs",
    "launch:check": "node scripts/launch-check.mjs"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.1.14",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0"
  },
  "pnpm": { "overrides": { "next>postcss": "8.5.23" } },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.27",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
