# Public origin, including https:// in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to production outside Vercel when the public live site is deployed
WICCLAW_DEPLOYMENT_STAGE=preview

# Stripe test keys first; use live keys only after launch review
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WICMINI_CURRENT_DEPOSIT=
STRIPE_PRICE_WICMINI_CURRENT_FULL=
STRIPE_PRODUCT_WICMINI_CURRENT=
# Optional only after separately approving an unpriced upcoming-version reservation
STRIPE_PRICE_WICMINI_NEXT_DEPOSIT=
STRIPE_PRODUCT_WICMINI_NEXT=
# Required for a separately charged full-order shipment. Leave empty only if WICCLAW_FULL_SHIPPING_POLICY=included is approved.
STRIPE_SHIPPING_RATE_FULL=
WICCLAW_FULL_SHIPPING_POLICY=
# Enable only after tax settings and registration obligations are approved
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Persistent Postgres database, with db/001_preorders.sql applied
DATABASE_URL=
DATABASE_SSL=true

# Transactional confirmation email
RESEND_API_KEY=
WICCLAW_EMAIL_FROM=
WICCLAW_SUPPORT_EMAIL=hello@wicclaw.ai

# At least 32 random characters; used only for the private operations page
WICCLAW_ADMIN_TOKEN=

# Merchant and preorder terms
# Seller supplied: Wicclaw Corp. Address is optional here pending merchant legal review.
WICCLAW_LEGAL_NAME=Wicclaw Corp
WICCLAW_BUSINESS_ADDRESS=
WICCLAW_SHIPPING_COUNTRIES=
WICCLAW_DELIVERY_ESTIMATE=
WICCLAW_PREORDER_REFUND_POLICY=
WICCLAW_DEPOSIT_TERMS=The $20 reservation deposit is fully refundable until the remaining hardware balance is paid.
WICCLAW_BALANCE_TERMS=
WICCLAW_NEXT_RESERVATION_APPROVED=false
WICCLAW_NEXT_RESERVATION_TERMS=
WICCLAW_NEXT_DELIVERY_ESTIMATE=

# Confirmed current WicMini Core physical specifications
WICCLAW_CURRENT_PROCESSOR=AMD Ryzen 7 7735HS
WICCLAW_CURRENT_MEMORY=16GB LPDDR5 RAM
WICCLAW_CURRENT_STORAGE=1TB NVMe SSD
WICCLAW_CURRENT_OS=Windows 11 Pro
WICCLAW_CURRENT_CONNECTIVITY=
WICCLAW_CURRENT_PORTS=
WICCLAW_CURRENT_PHYSICAL=
WICCLAW_CURRENT_ACCESSORIES=
WICCLAW_CURRENT_WORKLOAD=

# Set true only after the merchant reviews every public term and checkout total
WICCLAW_ORDER_TERMS_APPROVED=false
# Required in addition to the above for a live Stripe secret key
WICCLAW_LIVE_PAYMENT_APPROVED=false

# Optional only for a local production-build checkout preview
WICCLAW_LOCAL_PREVIEW=false
# Local development account data defaults to the ignored .runtime directory
WICCLAW_PREVIEW_STORAGE_DIR=
# Fail closed: set flags only after the corresponding real-world checks pass.
WICCLAW_CHECKOUT_ENABLED=false
WICCLAW_LEGAL_REVIEW_APPROVED=false
WICCLAW_FULL_PAYMENT_TERMS_APPROVED=false
WICCLAW_TAX_CONFIGURATION_APPROVED=false
WICCLAW_SHIPPING_APPROVED=false
WICCLAW_ASSETS_APPROVED=false
WICCLAW_SERVICES_VERIFIED=false
WICCLAW_TEST_PAYMENTS_VERIFIED=false
WICCLAW_WEBHOOK_VERIFIED=false
WICCLAW_DOMAIN_VERIFIED=false
WICCLAW_CONFIRMATION_ADMIN_VERIFIED=false

# Temporary reference media/fonts may be used only in loopback review builds.
# Never enable this on Hostinger or any public hostname.
WICCLAW_LOCAL_REFERENCE_REVIEW=false

